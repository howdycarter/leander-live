# Build-time defaults for all modes (committed; public values only — these
# ship in the client bundle, same as .env.production's GA ID).

# Google Tag Manager container ID. ONE source of truth for the container:
# index.html substitutes %VITE_GTM_ID% at build time and src/site/analytics.ts
# reads import.meta.env.VITE_GTM_ID — both resolve from this value.
# Override per build only when targeting another container:
#   VITE_GTM_ID=GTM-XXXXXXX npm run build
VITE_GTM_ID=GTM-T5HS9CSJ
