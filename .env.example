# Set automatically by `npx convex dev` (writes .env.local). Do not commit real values.
VITE_CONVEX_URL=

# Firecrawl — 20k credits for every hackathon participant. Sign up: https://www.firecrawl.dev
# Then: npx convex env set FIRECRAWL_API_KEY <key>
FIRECRAWL_API_KEY=

# AgentMail — gives the app an email inbox for organizer submissions. Sign up: https://agentmail.to
# Then: npx convex env set AGENTMAIL_API_KEY <key>
#       npx convex env set AGENTMAIL_INBOX <inbox-address>
#       npx convex env set AGENTMAIL_WEBHOOK_SECRET <secret>
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
AGENTMAIL_WEBHOOK_SECRET=

# OpenAI — generates one-line "why go" blurbs. Sign up: https://platform.openai.com
# (Convex AI Gateway is the keyless alternative but needs a paid Convex team.)
# Then: npx convex env set OPENAI_API_KEY <key>
OPENAI_API_KEY=
