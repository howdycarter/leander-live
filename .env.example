# Set automatically by `npx convex dev` (writes .env.local). Do not commit real values.
VITE_CONVEX_URL=

# --- Sign in with Google / Apple (Convex Auth) ---
# Create the OAuth clients, then set these in Convex (never commit real values):
#   npx convex env set AUTH_GOOGLE_ID <id> --prod
#   npx convex env set AUTH_GOOGLE_SECRET <secret> --prod
#   npx convex env set AUTH_APPLE_ID <services-id> --prod
#   npx convex env set AUTH_APPLE_SECRET <client-secret-jwt> --prod
# Redirect URIs to register with each provider:
#   Google: https://adventurous-ostrich-311.convex.site/api/auth/callback/google
#   Apple:  https://adventurous-ostrich-311.convex.site/api/auth/callback/apple
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Firecrawl — 20k credits for every hackathon participant. Sign up: https://www.firecrawl.dev
# Then: npx convex env set FIRECRAWL_API_KEY <key>
FIRECRAWL_API_KEY=<redacted>

# AgentMail — gives the app an email inbox for organizer submissions. Sign up: https://agentmail.to
# Then: npx convex env set AGENTMAIL_API_KEY <key>
#       npx convex env set AGENTMAIL_INBOX <inbox-address>
#       npx convex env set AGENTMAIL_WEBHOOK_SECRET <secret>
AGENTMAIL_API_KEY=<redacted>
AGENTMAIL_INBOX=
AGENTMAIL_WEBHOOK_SECRET=<redacted>

# OpenAI — event blurbs, chat bot, lead extraction, phone voice agent.
# Sign up: https://platform.openai.com — see BUDGET_SETUP.md for the $200 spending limit.
# Then: npx convex env set OPENAI_API_KEY <key>
OPENAI_API_KEY=<redacted>

# Chat model override (cheap tier only — never full-size/reasoning here).
# Default: gpt-4o-mini. Swap via: npx convex env set CHAT_MODEL <model>
CHAT_MODEL=

# Phone bot (Twilio + OpenAI Realtime). See PHONE_BOT_SETUP.md.
# Then: npx convex env set TWILIO_AUTH_TOKEN <token>
#       npx convex env set TWILIO_STREAM_URL wss://<voice-bridge-host>/
#       npx convex env set TWILIO_PUBLIC_URL https://<deployment>.convex.site
#       npx convex env set LEAD_INGEST_SECRET <random-secret>   (must match voice-bridge BRIDGE_SECRET)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_URL=
TWILIO_PUBLIC_URL=
LEAD_INGEST_SECRET=

# Voice model for the phone bot (mini realtime tier only — env-swappable).
# Default: gpt-realtime-2.1-mini. Set on the voice-bridge host, not Convex.
VOICE_MODEL=

# Mini-CRM admin gate (/admin/leads). Pick a long random string.
# Then: npx convex env set ADMIN_KEY <random-string>
ADMIN_KEY=
